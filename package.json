{
  "name": "@makinuki/mekuri",
  "version": "0.1.0",
  "description": "Headless-first manga and webtoon reader engine and view library",
  "license": "MIT",
  "author": { "name": "Byururu-sama", "url": "https://github.com/Byururu-sama" },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine.js"
    },
    "./views": {
      "types": "./dist/views/index.d.ts",
      "import": "./dist/views.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils/index.d.ts",
      "import": "./dist/test-utils.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc --emitDeclarationOnly -p tsconfig.dts.json",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test",
    "test:run": "vp test --run",
    "test:watch": "vp test --watch",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "example:dev": "vp dev examples/reader",
    "example:dev:lan": "vp dev examples/reader --host",
    "example:build": "vp build examples/reader",
    "example:build:dist": "vp build examples/reader --mode dist",
    "example:preview": "vp preview examples/reader",
    "test:e2e": "playwright test",
    "test:e2e:dist": "playwright test --config playwright.dist.config.ts",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
